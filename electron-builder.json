{
  "appId": "com.flybudget.app",
  "productName": "FlyBudget",
  "asar": false,
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/dist/main.js",
    "electron/dist/preload.js",
    "electron/dist/server.js",
    "client/dist/**",
    {
      "from": "server/node_modules/better-sqlite3",
      "to": "node_modules/better-sqlite3",
      "filter": ["**"]
    }
  ],
  "extraResources": [
    {
      "from": "server/src/db/migrations",
      "to": "migrations",
      "filter": ["**/*.sql", "meta/**"]
    }
  ],
  "npmRebuild": false,
  "toolsets": {
    "winCodeSign": "1.1.0"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.png"
  },
  "mac": {
    "target": "dmg"
  },
  "nsis": {
    "artifactName": "FlyBudget-Setup-${version}.${ext}"
  }
}
