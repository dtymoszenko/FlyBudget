{
  "appId": "com.flybudget.app",
  "productName": "FlyBudget",
  "asar": true,
  "asarUnpack": ["**/better-sqlite3/**"],
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/dist/main.js",
    "electron/dist/preload.js",
    "electron/dist/server.js",
    "electron/resources/icon.png",
    "client/dist/**",
    {
      "from": "server/node_modules/better-sqlite3",
      "to": "node_modules/better-sqlite3",
      "filter": ["**"]
    }
  ],
  "extraResources": [
    {
      "from": "server/src/db/migrations",
      "to": "migrations",
      "filter": ["**/*.sql", "meta/**"]
    }
  ],
  "npmRebuild": false,
  "toolsets": {
    "winCodeSign": "1.1.0"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/resources/icon.ico"
  },
  "nsis": {
    "artifactName": "FlyBudget-Windows-Setup.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "electron/resources/icon-1024.png",
    "category": "public.app-category.finance",
    "identity": "-",
    "hardenedRuntime": false,
    "artifactName": "FlyBudget-macOS-${arch}.${ext}"
  },
  "dmg": {
    "artifactName": "FlyBudget-macOS-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "electron/resources/icon-1024.png",
    "category": "Office",
    "executableName": "flybudget",
    "synopsis": "Budgeting that keeps your financial data on your computer",
    "description": "FlyBudget is a free, open-source budgeting app. Plan every dollar, track your accounts, and keep your financial data on your own computer.",
    "maintainer": "David Tymoszenko <dtymoszenko@users.noreply.github.com>",
    "vendor": "FlyBudget",
    "syncDesktopName": true
  },
  "appImage": {
    "artifactName": "FlyBudget-Linux-${arch}.${ext}"
  },
  "deb": {
    "artifactName": "FlyBudget-Linux-${arch}.${ext}"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableCookieEncryption": true,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false
  }
}
