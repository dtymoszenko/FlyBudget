{
  "appId": "com.flybudget.app",
  "productName": "FlyBudget",
  "asar": true,
  "asarUnpack": ["**/better-sqlite3/**"],
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/dist/main.js",
    "electron/dist/preload.js",
    "electron/dist/server.js",
    "electron/resources/icon.png",
    "client/dist/**",
    {
      "from": "server/node_modules/better-sqlite3",
      "to": "node_modules/better-sqlite3",
      "filter": ["**"]
    }
  ],
  "extraResources": [
    {
      "from": "server/src/db/migrations",
      "to": "migrations",
      "filter": ["**/*.sql", "meta/**"]
    }
  ],
  "npmRebuild": false,
  "toolsets": {
    "winCodeSign": "1.1.0"
  },
  "win": {
    "target": "nsis",
    "icon": "electron/resources/icon.ico"
  },
  "mac": {
    "target": "dmg"
  },
  "nsis": {
    "artifactName": "FlyBudget-Setup-${version}.${ext}"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableCookieEncryption": true,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false
  }
}
