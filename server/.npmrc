# better-sqlite3 >=13 ships Node-API prebuilds and opts out of node-gyp with
# "gypfile": false, but npm ignores that when installing from package-lock.json
# and tries `node-gyp rebuild` (fails without a C++ toolchain, e.g. on Windows).
# No other server dependency needs an install script (esbuild's postinstall
# only verifies its binary), so skip them all.
ignore-scripts=true
